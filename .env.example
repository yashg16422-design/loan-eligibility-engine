# LOCAL-ONLY example for `docker compose --profile local up -d`.
# On AWS this file is NOT used: deploy/n8n/boot.sh writes .env from Secrets Manager.
# Never commit a real .env (it is gitignored).

# n8n's own storage -> the local Postgres container
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=change-me-local-only

# Encrypts credentials stored by n8n. Generate one: openssl rand -hex 32
N8N_ENCRYPTION_KEY=change-me-generate-with-openssl

N8N_PROTOCOL=http
N8N_SECURE_COOKIE=false
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Asia/Kolkata
TZ=Asia/Kolkata
N8N_DIAGNOSTICS_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
EXECUTIONS_TIMEOUT=600
EXECUTIONS_TIMEOUT_MAX=900
